{
  "name": "three-fdm-studio",
  "version": "0.1.2-rc.1",
  "description": "React and three.js GLB studio for previewing 3D-printed products with procedural FDM grain, glitter, studio lighting and picking.",
  "type": "module",
  "license": "MIT",
  "author": "m1chlcz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M1chlCZ/three-fdm-studio.git"
  },
  "homepage": "https://github.com/m1chlcz/three-fdm-studio#readme",
  "bugs": "https://github.com/m1chlcz/three-fdm-studio/issues",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.185.4",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
